# Copy to .env.local (not committed) and fill in from Supabase → Project Settings → API.
# Leave empty to build the app with accounts switched off.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: address used in invite links (defaults to the address the app is opened from).
VITE_PUBLIC_APP_URL=https://deltus.github.io/solaristic-pulse/
# Optional: direct download link for the Android APK shown on invites (e.g. a GitHub Release asset).
VITE_ANDROID_APK_URL=
